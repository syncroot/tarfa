+// Patched for GLM5-Next layer probe: dumps full tensors (raw bytes + .meta) for the
+// comma-separated ggml names in env GLM5_DUMP, into env GLM5_DUMP_DIR.
+// Run with -ngl 0 so activations live in host memory. Original behaviour is kept
+// when GLM5_DUMP is unset (falls back to common_debug_cb_eval).
 #include "arg.h"
 #include "common.h"
 #include "debug.h"
 #include "log.h"
 #include "llama.h"
+#include "ggml.h"
+#include "ggml-backend.h"
 
 #include <clocale>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
 #include <string>
 #include <vector>
 
+static std::set<std::string> g_dump_names;
+static std::string           g_dump_dir = ".";
+
+static bool dump_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    (void) user_data;
+    if (ask) {
+        return g_dump_names.count(t->name) > 0;
+    }
+    if (g_dump_names.count(t->name) == 0) {
+        return true;
+    }
+    const size_t nbytes = ggml_nbytes(t);
+    std::vector<char> raw(nbytes);
+    ggml_backend_tensor_get(t, raw.data(), 0, nbytes);
+
+    char path[1200];
+    snprintf(path, sizeof(path), "%s/%s.bin", g_dump_dir.c_str(), t->name);
+    if (FILE * f = fopen(path, "wb")) { fwrite(raw.data(), 1, nbytes, f); fclose(f); }
+
+    snprintf(path, sizeof(path), "%s/%s.meta", g_dump_dir.c_str(), t->name);
+    if (FILE * f = fopen(path, "w")) {
+        fprintf(f, "type=%d ne=%lld,%lld,%lld,%lld nb=%zu,%zu,%zu,%zu\n",
+                (int) t->type,
+                (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                t->nb[0], t->nb[1], t->nb[2], t->nb[3]);
+        fclose(f);
+    }
+    return true;
+}
+
